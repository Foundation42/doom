    "parallel": "ts-node examples/parallel.ts",
    "tools": "ts-node examples/tools-demo.ts",
    "tools:local": "ts-node examples/tools-demo-local.ts",
    "tools:advanced": "ts-node examples/tools-demo-advanced.ts",
