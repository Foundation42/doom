{
  "name": "doom",
  "version": "1.0.0",
  "description": "The AI agent that *doesn't* ruin everything",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "doom": "./bin/doom.js"
  },
  "scripts": {
    "build": "tsc",
    "build:cli": "node scripts/build-cli.js",
    "build:all": "npm run build && npm run build:cli",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "subtasks": "ts-node examples/subtasks.ts",
    "parallel": "ts-node examples/parallel.ts",
    "tools": "ts-node examples/tools-demo.ts",
    "tools:local": "ts-node examples/tools-demo-local.ts",
    "tools:advanced": "ts-node examples/tools-demo-advanced.ts",
    "tools:ai": "ts-node examples/advanced-tools-demo.ts",
    "test:ai": "ts-node examples/ai-tools-test.ts",
    "doom": "ts-node cli/doom.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Foundation42/doom.git"
  },
  "keywords": [
    "ai",
    "llm",
    "doom",
    "tools",
    "agent",
    "openai",
    "gpt",
    "anthropic"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google-cloud/vertexai": "^1.9.3",
    "@google/generative-ai": "^0.22.0",
    "@mistralai/mistralai": "^1.5.0",
    "abort-controller": "^3.0.0",
    "chalk": "^4.1.2",
    "dotenv": "^16.0.3",
    "minimatch": "^10.0.1",
    "node-fetch": "^2.6.9",
    "openai": "^4.86.1",
    "readline-sync": "^1.4.10"
  },
  "devDependencies": {
    "@types/jest": "^29.5.1",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^18.16.0",
    "@types/node-fetch": "^2.6.3",
    "@types/readline-sync": "^1.4.4",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "bun": "^1.2.10",
    "esbuild": "^0.25.2",
    "eslint": "^8.39.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4"
  }
}
