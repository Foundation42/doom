{
  "name": "chatrunner",
  "version": "0.1.0",
  "description": "Run chat sessions with OpenAI's tool-calling models",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "repl": "ts-node examples/repl.ts",
